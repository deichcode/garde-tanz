rules_version = '2';
// Musik der Tänze (ab M3). Nur Mitglieder, nur Audio, höchstens 50 MB.
service firebase.storage {
  match /b/{bucket}/o {
    match /music/{danceId}/{file} {
      allow read: if request.auth != null && request.auth.token.member == true;
      allow write: if request.auth != null && request.auth.token.member == true
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow delete: if request.auth != null && request.auth.token.member == true;
    }
  }
}
