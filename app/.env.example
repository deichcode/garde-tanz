# Kopieren nach .env.local und ausfüllen (siehe docs/04-einrichtung.md). Alles keine Geheimnisse.
# Ohne diese Werte startet die App als Vorschau ohne Anmeldung, Daten nur auf dem Gerät.

# Firebase-Projekt (Projekteinstellungen → Allgemein → Web-App)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Domain, unter der die App läuft (wichtig für die Anmeldung in der installierten iPhone-App),
# z. B. garde-tanz.web.app. Leer = <projekt>.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=

# Microsoft Entra ID: Verzeichnis-ID (Tenant-ID) des Vereins
VITE_MS_TENANT_ID=
